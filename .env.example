# ============================================================
# ENVIRONMENT VARIABLES — Copy this file to .env and fill in
# ============================================================

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL on Railway/Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth / JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Admin Account (set up via: npx tsx prisma/seed.ts)
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-password"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Optional: AI Image Generation (if you add later)
# OPENAI_API_KEY="sk-..."
# STABILITY_API_KEY="sk-..."
