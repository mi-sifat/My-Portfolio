# ============================================================
# ENVIRONMENT VARIABLES — Copy this file to .env and fill in
# NEVER commit your actual .env file to git!
# ============================================================

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL on Railway/Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth / JWT Secret (REQUIRED — generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-random-64-char-secret"

# Admin Account (REQUIRED — used by: npx tsx prisma/seed.ts)
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-password-min-12-chars"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Optional: AI Image Generation (if you add later)
# OPENAI_API_KEY="sk-..."
# STABILITY_API_KEY="sk-..."

