# ============================================================
# ENVIRONMENT VARIABLES — Copy this to .env and fill in values
# NEVER commit your actual .env file to git!
# ============================================================

# ── LOCAL DEVELOPMENT (SQLite) ──────────────────────────────
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# ── PRODUCTION (Neon PostgreSQL — free at neon.tech) ────────
# Get these from: https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── AUTH ─────────────────────────────────────────────────────
# JWT Secret (REQUIRED) — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-64-char-secret"

# Admin credentials (used by: npx tsx prisma/seed.ts)
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-password-min-12-chars"

# ── NEXT.JS ──────────────────────────────────────────────────
NEXTAUTH_URL="https://your-app.vercel.app"

